#!/bin/bash

set -e

source "$HOME/bin/lib/brew-context.sh"

extract_verbose "$@"
set -- "${VERBOSE_ARGS[@]}"
[ "$VERBOSE" = yes ] && set -x

verbose_flag=()
[ "$VERBOSE" = yes ] && verbose_flag=(--verbose)

function config() {
  git --git-dir=$HOME/.cfg/ --work-tree=$HOME $@
}

trap 'echo Terminated $0; exit' INT

config pull

brew bundle check --verbose || true

prompt "Continue? y/n"

brew bundle install "${verbose_flag[@]}"
brew cleanup

commit_and_push "Update" "$BREWFILE"
