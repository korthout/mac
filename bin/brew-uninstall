#!/bin/bash

if [ "$#" -eq "0" ]; then
	echo "Uninstalls a package using brew bundle"
	echo ""
	echo "Usage: brew-uninstall <package>"
	echo ""
	echo "Note that this tool may uninstall other packages when syncing Brewfile"
	exit 0
fi

set -ex

source "$HOME/bin/lib/brew-context.sh"

require_single_package "$@"

function config() {
	git --git-dir=$HOME/.cfg/ --work-tree=$HOME $@
}

trap 'echo Terminated $0; exit' INT

config pull

read -r pkg_type pkg_name _ < <(resolve_package "$@")

brew uninstall "$@"

remove_from_other=no
if in_bundle "$pkg_type" "$pkg_name" "$OTHER_BREWFILE"; then
	if prompt "'$pkg_name' is shared. Remove entirely (affects the other side too)? [y/N]"; then
		remove_from_other=yes
		echo "Removing '$pkg_name' entirely — both contexts will lose it."
	else
		echo "Keeping '$pkg_name' for the other side — only removing it from $CONTEXT."
	fi
fi

brew bundle remove --"$pkg_type" "$pkg_name"

# Only the files actually written get staged, so an unrelated edit sitting
# in the other context's Brewfile doesn't get swept into an Uninstall commit.
written=("$BREWFILE")
if [ "$remove_from_other" = yes ]; then
	HOMEBREW_BUNDLE_FILE="$OTHER_BREWFILE" brew bundle remove --"$pkg_type" "$pkg_name"
	written+=("$OTHER_BREWFILE")
fi

commit_and_push "Uninstall-$pkg_name" "${written[@]}"
