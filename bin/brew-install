#!/bin/bash

if [ "$#" -eq "0" ]; then
	echo "Installs a new package using brew bundle"
	echo ""
	echo "Usage: brew-install [--cask] [--verbose] <package>"
	echo ""
	echo "Note that this tool may install other packages when syncing Brewfile"
	exit 0
fi

set -e

source "$HOME/bin/lib/brew-context.sh"

extract_verbose "$@"
set -- "${VERBOSE_ARGS[@]}"
[ "$VERBOSE" = yes ] && set -x

require_single_package "$@"

function config() {
	git --git-dir=$HOME/.cfg/ --work-tree=$HOME $@
}

trap 'echo Terminated $0; exit' INT

config pull

verbose_flag=()
[ "$VERBOSE" = yes ] && verbose_flag=(-v)

brew install "${verbose_flag[@]}" "$@"

read -r pkg_type pkg_name pkg_tap < <(resolve_package "$@")

share=no
if in_bundle "$pkg_type" "$pkg_name" "$BREWFILE" && in_bundle "$pkg_type" "$pkg_name" "$OTHER_BREWFILE"; then
	share=yes
	echo "'$pkg_name' is already shared."
elif prompt "Do you want to share '$pkg_name'? [y/N]"; then
	share=yes
	echo "Sharing '$pkg_name' — adding it to both contexts."
else
	echo "Keeping '$pkg_name' for $CONTEXT only."
fi

ensure_tap "$pkg_tap" "$BREWFILE"
brew bundle add --"$pkg_type" "$pkg_name"

# Only the files actually written get staged, so an unrelated edit sitting
# in the other context's Brewfile doesn't get swept into an Install commit.
written=("$BREWFILE")
if [ "$share" = yes ]; then
	ensure_tap "$pkg_tap" "$OTHER_BREWFILE"
	HOMEBREW_BUNDLE_FILE="$OTHER_BREWFILE" brew bundle add --"$pkg_type" "$pkg_name"
	written+=("$OTHER_BREWFILE")
fi

commit_and_push "Install-$pkg_name" "${written[@]}"
